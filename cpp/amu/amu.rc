#include <windows.h>

// Application icon. Resource ID 1 is both what Explorer/the taskbar picks up and
// what main_sciter.cpp loads for the window title-bar icon (WM_SETICON).
1 ICON "amu.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,0,0
 PRODUCTVERSION 2,2,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "oNdsen"
            VALUE "FileDescription",  "ARK Mod Updater"
            VALUE "FileVersion",      "2.2.0.0"
            VALUE "InternalName",     "amu"
            VALUE "LegalCopyright",   "Copyright (c) 2026 oNdsen"
            VALUE "OriginalFilename", "amu.exe"
            VALUE "ProductName",      "ARK Mod Updater"
            VALUE "ProductVersion",   "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
